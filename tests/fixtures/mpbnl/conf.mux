general {
    dabmode 1
    nbframes 0
    syslog false
    tist false
    managementport 12720
}

remotecontrol {
    telnetport 12721
    zmqendpoint tcp://lo:12722
}

ensemble {
    id 0x2EA1
    ecc 0xe3
    local-time-offset auto
    international-table 1
    reconfig-counter hash
    label "MPBNL DAB1"
    shortlabel "MPB DAB1"
}

linking {
    set-mpb1 {
        ; Linkage Set Number, 12-bit, must be unique within the country
        lsn 0x491
        active true
        hard true
        ; international because the linked DAB service uses a different ECC (E1)
        international true
        keyservice srv-01
        list {
            mpb1-fm {
                type fm
                id 0x2491
                ecc 0xe3
            }
            mpb1-dab-5a {
                ; MPB Radio 1 on 5A, EId 0xCFCB
                type dab
                id 0xC249
                ecc 0xe1
            }
        }
    }
    set-mpb2 {
        lsn 0x492
        active true
        hard true
        international true
        keyservice srv-02
        list {
            mpb2-fm {
                type fm
                id 0x2492
                ecc 0xe3
            }
            mpb2-dab-5a {
                ; MPB Radio 2 on 5A, EId 0xCFCB
                type dab
                id 0x2492
                ecc 0xe3
            }
        }
    }
}

frequency_information {
    fi-mpb1-fm {
        range_modulation fm
        continuity true
        pi_code 0x2491
        frequencies "98.2 97.4 99.7 100.3 103.3 107.8"
    }
    fi-mpb2-fm {
        range_modulation fm
        continuity true
        pi_code 0x2492
        frequencies "94.6 94.9"
    }
    fi-dab-cfcb {
        range_modulation dab
        continuity true
        eid 0xCFCB
        frequencies {
            ch-5a {
                ; Block 5A = 174.928 MHz
                frequency 174.928
                signal_mode_1 true
                adjacent true
            }
        }
    }
}

