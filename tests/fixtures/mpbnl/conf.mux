subchannels {
    sub-01 {
        type dabplus
        bitrate 128
        id 1
	protection-profile EEP_B
        protection 4
        inputproto edi
        inputuri "tcp://0.0.0.0:9001"
        buffer-management prebuffering
        buffer 40
        prebuffering 20
    }
