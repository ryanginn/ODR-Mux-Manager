outputs {
    edi {
        destinations {
            edi_tcp {
                protocol tcp
                listenport 9201
            }
        }
    }

    ; Throttle output to real-time (one ETI frame every 24ms)
    zmq "zmq+tcp://*:18081"
    throttle "simul://"
}
