subchannels {
    sub-01 {
        type audio
        bitrate 128
        id 1
        protection-profile UEP
        protection 3
        inputproto edi
        inputuri "tcp://0.0.0.0:9001"
        buffer-management prebuffering
        buffer 40
        prebuffering 20
