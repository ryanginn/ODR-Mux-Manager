general {
    dabmode 1
    nbframes 0
    syslog false
    tist false
    managementport 12720
}

remotecontrol {
    telnetport 12721
}

ensemble {
    id 0x2EA2
    ecc 0xe3
    local-time-offset auto
    label "MPBNL DAB2"
    shortlabel "MPB DAB2"
}

services {
    srv-01 {
        id 0x2501
        label "RTE Radio 1"
        shortlabel "RTE Radi"
        pty 10
    }
    srv-02 {
